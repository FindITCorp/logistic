# FINDIT — Variables de entorno
# Copia este archivo a .env.local y completa con tus valores reales.
# NUNCA commitees .env.local al repositorio.

# ============================================================================
# Supabase
# ============================================================================
# Obtén estos valores en: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# App
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FINDIT

# ============================================================================
# Pricing (valores por defecto si BD no responde)
# ============================================================================
NEXT_PUBLIC_DEFAULT_MARKET_RATE_PER_M3=600
NEXT_PUBLIC_DEFAULT_MAX_RATE_PER_M3=300

# ============================================================================
# Analytics (opcional)
# ============================================================================
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=findit.com

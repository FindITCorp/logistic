# FINDIT Logistic — Variables de entorno
# Copia este archivo a .env.local y completa con tus valores reales.
# NUNCA commitees .env.local al repositorio.

# ============================================================================
# Supabase
# ============================================================================
# Obtén estos valores en: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# App
# ============================================================================
NEXT_PUBLIC_SITE_URL=https://logistic-six-alpha.vercel.app
# En local: NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================================
# Admin
# ============================================================================
# Clave para crear el primer admin via POST /api/admin/setup
# Genera una clave aleatoria: openssl rand -hex 32
ADMIN_SETUP_KEY=cambia-esto-por-una-clave-segura

# ============================================================================
# Cron jobs (Vercel Cron)
# ============================================================================
# Protege el endpoint /api/cron/advance-pools
# Genera: openssl rand -hex 32
CRON_SECRET=cambia-esto-por-una-clave-secreta

# ============================================================================
# Notificaciones (opcional)
# ============================================================================
# GitHub PAT con scope repo — permite crear Issues como fallback de leads
GITHUB_TOKEN_NOTIFY=ghp_...
